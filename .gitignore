# ─────────────────────────────────────────────────────────────────────────────
# SECURITY & CONFIGURATION (CRITICAL)
# ─────────────────────────────────────────────────────────────────────────────
# Never commit real credentials, API keys, or environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON BACKEND DEPENDENCIES & RUNTIMES
# ─────────────────────────────────────────────────────────────────────────────
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
v構築/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND DEPENDENCIES & BUILDS (React)
# ─────────────────────────────────────────────────────────────────────────────
# Dependencies
frontend/node_modules/
node_modules/

# Production build output
frontend/dist/
frontend/build/
dist/

# Front-end log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# DATA STORES, CACHES & LOCAL VECTOR DATABASES
# ─────────────────────────────────────────────────────────────────────────────
# Persistent storage folders for ChromaDB / local caches
.chroma/
knowledge/chromadb_storage/
*.db
*.sqlite3

# Redis local persistent dumps
infra/redis/dump.rdb
*.rdb

# Raw Financial Evaluation Documents (10-Ks, PDFs)
# Protects against committing heavy or proprietary documentation files
knowledge/documents/*.pdf
knowledge/documents/*.txt
!knowledge/documents/.gitkeep

# ─────────────────────────────────────────────────────────────────────────────
# TESTING, LOGS & DIAGNOSTICS
# ─────────────────────────────────────────────────────────────────────────────
# Log directories
logs/
*.log

# Pytest / Coverage reporting
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
pytestdebug.log

# ─────────────────────────────────────────────────────────────────────────────
# IDE, SYSTEM & OS SPECIFIC FILES
# ─────────────────────────────────────────────────────────────────────────────
# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Operating Systems
DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

.history